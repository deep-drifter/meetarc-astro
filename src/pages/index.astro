				<div class="flex items-center gap-6">
					<a href="https://www.flow-medtech.com" target="_blank" class="hover:text-white transition-colors">FLOW MEDTECH</a>
					<a href="https://www.linkedin.com/in/chakrabortyarnab" target="_blank" class="hover:text-white transition-colors">LINKEDIN</a>
