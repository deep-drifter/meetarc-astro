---
// Astro Page Component - High-Aura Portfolio for Arnab Chakraborty
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Arnab Chakraborty</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<style>
			/* Dynamic Marquee */
			@keyframes marquee {
				0% { transform: translateX(0%); }
				100% { transform: translateX(-50%); }
			}
			.animate-marquee {
				display: flex;
				width: 200%;
				animation: marquee 22s linear infinite;
			}
			.animate-marquee:hover {
				animation-play-state: paused;
			}
			/* Subtly textured background grid */
			.bg-grid-pattern {
				background-size: 80px 80px;
				background-image: 
					linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
			}
			/* High-end glass cards */
			.glass-card {
				background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
				backdrop-filter: blur(24px);
				-webkit-backdrop-filter: blur(24px);
				border: 1px solid rgba(255, 255, 255, 0.07);
			}
			.glass-card:hover {
				border-color: rgba(165, 180, 252, 0.25);
				box-shadow: 0 0 50px rgba(99, 102, 241, 0.08);
			}
		</style>
	</head>
	<body class="bg-[#060709] text-[#F4F4F5] font-['Plus_Jakarta_Sans'] antialiased selection:bg-indigo-500 selection:text-white overflow-x-hidden">

		<!-- Subtle Environmental Lighting -->
		<div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0 opacity-100"></div>
		<div class="fixed inset-0 pointer-events-none z-0">
			<div class="absolute top-[-15%] left-[-10%] w-[650px] h-[650px] rounded-full bg-indigo-600/10 blur-[160px]"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[750px] h-[750px] rounded-full bg-cyan-600/10 blur-[180px]"></div>
		</div>

		<!-- Navigation -->
		<nav class="fixed top-0 left-0 w-full z-50 px-4 sm:px-8 py-6">
			<div class="max-w-7xl mx-auto glass-card rounded-full px-6 py-3.5 flex items-center justify-between">
				<a href="#" class="flex items-center gap-2 group">
					<span class="w-2 h-2 rounded-full bg-indigo-400 group-hover:scale-150 transition-all duration-300"></span>
					<span class="font-bold text-xs tracking-widest uppercase font-['JetBrains_Mono'] text-white">ARNAB CHAKRABORTY</span>
				</a>
				
				<div class="hidden md:flex items-center gap-8 text-[11px] uppercase tracking-widest font-['JetBrains_Mono'] text-zinc-400">
					<a href="#manifesto" class="hover:text-white transition-colors">01. Manifesto</a>
					<a href="#ventures" class="hover:text-white transition-colors">02. Work</a>
					<a href="#outlook" class="hover:text-white transition-colors">03. Forecasts</a>
					<a href="#impact" class="hover:text-white transition-colors">04. Distinction</a>
				</div>

				<div class="flex items-center gap-4">
					<a href="#contact" class="px-5 py-2 rounded-full bg-white text-black font-semibold text-xs tracking-wider uppercase hover:bg-zinc-200 transition-all">
						Connect
					</a>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative z-10 min-h-screen flex items-center justify-center pt-32 pb-20 px-6">
			<div class="max-w-5xl mx-auto text-center space-y-10">
				
				<!-- Live Telemetry Pill -->
				<div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full glass-card text-xs font-['JetBrains_Mono'] text-indigo-300 border border-indigo-500/20">
					<span class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<span class="text-white">ATLANTA</span>
					</span>
					<span class="text-zinc-600">|</span>
					<span>GT BME</span>
					<span class="text-zinc-600">|</span>
					<span>MEDTECH x SMART MATERIALS</span>
				</div>

				<!-- Bold Statement Headline -->
				<h1 class="text-4xl sm:text-7xl lg:text-8xl font-light tracking-tight leading-[1.02]">
					Predicting shifts. <br>
					<span class="font-['Playfair_Display'] italic font-normal bg-gradient-to-r from-white via-indigo-100 to-indigo-400 bg-clip-text text-transparent">
						Engineering physical realities.
					</span>
				</h1>

				<p class="max-w-2xl mx-auto text-zinc-400 text-base sm:text-lg font-light leading-relaxed">
					Biomedical engineer & multi-industry founder operating at the convergence of cardiovascular medical devices, luxury smart apparel, and venture networks.
				</p>

				<!-- Buttons -->
				<div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center items-center font-['JetBrains_Mono'] text-xs">
					<a href="#ventures" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white text-black font-semibold tracking-wider uppercase hover:bg-zinc-200 transition-all flex items-center justify-center gap-3 shadow-xl shadow-white/5">
						Selected Work
						<span>↓</span>
					</a>
					<a href="#outlook" class="w-full sm:w-auto px-8 py-4 rounded-full glass-card text-zinc-300 font-medium tracking-wider uppercase hover:text-white transition-all flex items-center justify-center gap-2">
						Trend Analysis
					</a>
				</div>
			</div>
		</section>

		<!-- Kinetic Marquee -->
		<div class="relative z-10 py-5 border-y border-white/5 bg-black/50 backdrop-blur-md overflow-hidden">
			<div class="animate-marquee whitespace-nowrap flex items-center gap-12 font-['JetBrains_Mono'] text-xs tracking-widest text-zinc-500 uppercase">
				<span>FLOW MEDTECH</span>
				<span class="text-indigo-400">✦</span>
				<span>AWOKEN MATTER</span>
				<span class="text-indigo-400">✦</span>
				<span>FOUNDERSFORGE</span>
				<span class="text-indigo-400">✦</span>
				<span>GEORGIA TECH 40 UNDER 40</span>
				<span class="text-indigo-400">✦</span>
				<span>CARDIOVASCULAR IMPLANTS</span>
				<span class="text-indigo-400">✦</span>
				<span>CONDUCTIVE TEXTILES</span>
				<span class="text-indigo-400">✦</span>
				<span>FLOW MEDTECH</span>
				<span class="text-indigo-400">✦</span>
				<span>AWOKEN MATTER</span>
				<span class="text-indigo-400">✦</span>
			</div>
		</div>

		<!-- Manifesto Section -->
		<section id="manifesto" class="relative z-10 py-32 px-6">
			<div class="max-w-6xl mx-auto glass-card rounded-3xl p-8 sm:p-16 relative overflow-hidden">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
					<div class="lg:col-span-4 space-y-3">
						<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-widest uppercase">// 01. THESIS</span>
						<h2 class="text-3xl sm:text-4xl font-light leading-tight">Most innovation dies in silos. <br><span class="italic font-['Playfair_Display'] text-indigo-300">I build across them.</span></h2>
					</div>
					<div class="lg:col-span-8 space-y-6 text-zinc-300 text-base sm:text-lg leading-relaxed font-light">
						<p>
							Real breakthroughs don't happen inside isolated industries—they happen at the collision points. Trained in Biomedical Engineering at Georgia Tech, I co-founded <strong class="text-white font-normal">Flow MedTech</strong> to engineer stroke-prevention heart implants that solve critical clinical risks.
						</p>
						<p>
							I apply that same technical rigour to physical culture and design systems with <strong class="text-white font-normal">Awoken Matter</strong>—fusing wearable sensors into modern garments—and venture architecture with <strong class="text-white font-normal">FoundersForge</strong>. No fluff. Just execution.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Selected Work Bento Grid -->
		<section id="ventures" class="relative z-10 py-24 px-6">
			<div class="max-w-6xl mx-auto space-y-12">
				<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
					<div>
						<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-widest uppercase">// 02. VENTURE MATRIX</span>
						<h2 class="text-3xl sm:text-5xl font-light mt-2">Core Initiatives</h2>
					</div>
					<p class="text-zinc-400 text-xs font-['JetBrains_Mono'] tracking-wider uppercase">
						MEDTECH • SMART MATERIALS • ECOSYSTEMS
					</p>
				</div>

				<!-- Bento Grid -->
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
					
					<!-- Bento 1: Flow MedTech (8 cols) -->
					<div class="md:col-span-8 glass-card rounded-3xl p-8 sm:p-10 flex flex-col justify-between space-y-8 group">
						<div class="space-y-4">
							<div class="flex justify-between items-start">
								<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-wider uppercase">01 / BIOMEDICAL ENGINEERING</span>
								<span class="px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-['JetBrains_Mono']">Co-Founder & CTO</span>
							</div>
							<h3 class="text-3xl font-semibold text-white group-hover:text-indigo-200 transition-colors">Flow MedTech</h3>
							<p class="text-zinc-300 text-base leading-relaxed font-light max-w-xl">
								Engineered a novel Left Atrial Appendage (LAA) occlusion heart implant designed to eliminate stroke risk in atrial fibrillation patients without long-term blood thinners. Supported by the Cleveland Clinic GCIC.
							</p>
						</div>

						<div class="pt-6 border-t border-white/5 flex flex-wrap items-center justify-between gap-4 font-['JetBrains_Mono'] text-xs text-zinc-400">
							<span>CLINICAL IMPLANTS • PATENTED TECH</span>
							<span class="text-indigo-400 group-hover:translate-x-1 transition-transform">Explore MedTech →</span>
						</div>
					</div>

					<!-- Bento 2: Distinction Tile (4 cols) -->
					<div class="md:col-span-4 glass-card rounded-3xl p-8 flex flex-col justify-between space-y-6 bg-gradient-to-br from-indigo-950/20 to-black/80">
						<div class="space-y-3">
							<span class="font-['JetBrains_Mono'] text-xs text-amber-400 tracking-widest uppercase">ACCOLADE</span>
							<h4 class="text-2xl font-light text-white">Georgia Tech 40 Under 40</h4>
						</div>
						<p class="text-zinc-400 text-xs leading-relaxed font-light">
							Recognized in GT's inaugural honoree class for pioneering cardiovascular device innovation and cross-industry leadership.
						</p>
						<div class="pt-4 border-t border-white/5 font-['JetBrains_Mono'] text-xs text-amber-300">
							INAUGURAL CLASS HONOREE
						</div>
					</div>

					<!-- Bento 3: Awoken Matter (6 cols) -->
					<div class="md:col-span-6 glass-card rounded-3xl p-8 flex flex-col justify-between space-y-8 group">
						<div class="space-y-4">
							<div class="flex justify-between items-start">
								<span class="font-['JetBrains_Mono'] text-xs text-cyan-400 tracking-wider uppercase">02 / SMART APPAREL</span>
								<span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-xs font-['JetBrains_Mono']">Founder</span>
							</div>
							<h3 class="text-2xl font-semibold text-white group-hover:text-cyan-200 transition-colors">Awoken Matter</h3>
							<p class="text-zinc-400 text-sm leading-relaxed font-light">
								Fusing contemporary high-fashion design systems with smart textiles, integrated sensing materials, and futuristic functional garment engineering.
							</p>
						</div>
						<div class="pt-6 border-t border-white/5 flex justify-between items-center font-['JetBrains_Mono'] text-xs text-zinc-400">
							<span>@awokenmatter</span>
							<span class="text-cyan-400 group-hover:translate-x-1 transition-transform">Explore System →</span>
						</div>
					</div>

					<!-- Bento 4: FoundersForge (6 cols) -->
					<div class="md:col-span-6 glass-card rounded-3xl p-8 flex flex-col justify-between space-y-8 group">
						<div class="space-y-4">
							<div class="flex justify-between items-start">
								<span class="font-['JetBrains_Mono'] text-xs text-purple-400 tracking-wider uppercase">03 / VENTURE SYSTEMS</span>
								<span class="px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-['JetBrains_Mono']">Ecosystem Builder</span>
							</div>
							<h3 class="text-2xl font-semibold text-white group-hover:text-purple-200 transition-colors">FoundersForge</h3>
							<p class="text-zinc-400 text-sm leading-relaxed font-light">
								Accelerating high-conviction entrepreneurs through tactical startup execution, founder education, and capital-readiness infrastructure.
							</p>
						</div>
						<div class="pt-6 border-t border-white/5 flex justify-between items-center font-['JetBrains_Mono'] text-xs text-zinc-400">
							<span>ACCELERATION INFRASTRUCTURE</span>
							<span class="text-purple-400 group-hover:translate-x-1 transition-transform">Explore Platform →</span>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- Trend Forecasting Section -->
		<section id="outlook" class="relative z-10 py-24 px-6">
			<div class="max-w-5xl mx-auto space-y-12">
				<div class="space-y-2">
					<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-widest uppercase">// 03. FORESIGHT</span>
					<h2 class="text-3xl sm:text-4xl font-light">Trend Forecasts & Essays</h2>
				</div>

				<div class="space-y-4">
					
					<article class="glass-card p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-center gap-6 group cursor-pointer">
						<div class="space-y-2 max-w-2xl">
							<div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-zinc-500">
								<span>MEDTECH & SENSING</span>
								<span>•</span>
								<span>5 MIN READ</span>
							</div>
							<h3 class="text-xl font-medium text-white group-hover:text-indigo-300 transition-colors">
								Beyond the Screen: Why the Next Generation of Diagnostics Is Woven Into Fabric
							</h3>
						</div>
						<div class="font-['JetBrains_Mono'] text-xs text-indigo-400 flex items-center gap-2 group-hover:translate-x-2 transition-transform">
							READ ESSAY <span>→</span>
						</div>
					</article>

					<article class="glass-card p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-center gap-6 group cursor-pointer">
						<div class="space-y-2 max-w-2xl">
							<div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-zinc-500">
								<span>MATERIALS & DESIGN</span>
								<span>•</span>
								<span>4 MIN READ</span>
							</div>
							<h3 class="text-xl font-medium text-white group-hover:text-cyan-300 transition-colors">
								Functional Materiality: Modern Design Systems for the Physical World
							</h3>
						</div>
						<div class="font-['JetBrains_Mono'] text-xs text-cyan-400 flex items-center gap-2 group-hover:translate-x-2 transition-transform">
							READ ESSAY <span>→</span>
						</div>
					</article>

					<article class="glass-card p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-center gap-6 group cursor-pointer">
						<div class="space-y-2 max-w-2xl">
							<div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-zinc-500">
								<span>ECOSYSTEMS</span>
								<span>•</span>
								<span>6 MIN READ</span>
							</div>
							<h3 class="text-xl font-medium text-white group-hover:text-purple-300 transition-colors">
								The Anti-Fluff Playbook: Building Regional Founder Networks That Execute
							</h3>
						</div>
						<div class="font-['JetBrains_Mono'] text-xs text-purple-400 flex items-center gap-2 group-hover:translate-x-2 transition-transform">
							READ ESSAY <span>→</span>
						</div>
					</article>

				</div>
			</div>
		</section>

		<!-- Recognition / Distinction -->
		<section id="impact" class="relative z-10 py-24 px-6">
			<div class="max-w-6xl mx-auto glass-card rounded-3xl p-8 sm:p-16 border border-white/10">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="space-y-6">
						<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-widest uppercase">// 04. DISTINCTION</span>
						<h2 class="text-3xl sm:text-4xl font-light leading-tight">Recognized across innovation ecosystems.</h2>
						<p class="text-zinc-400 text-sm font-light leading-relaxed">
							Honored in Georgia Tech's inaugural 40 Under 40 class and the Tri-Cities Business Journal 40 Under 40 for patenting stroke-prevention heart implants and scaling multi-industry ventures.
						</p>
					</div>
					<div class="grid grid-cols-2 gap-6">
						<div class="bg-black/40 border border-white/5 p-6 rounded-2xl text-center space-y-2">
							<p class="text-2xl sm:text-3xl font-bold text-white font-['JetBrains_Mono']">40 UNDER 40</p>
							<p class="text-[11px] text-zinc-500 uppercase tracking-wider font-['JetBrains_Mono']">Georgia Tech</p>
						</div>
						<div class="bg-black/40 border border-white/5 p-6 rounded-2xl text-center space-y-2">
							<p class="text-2xl sm:text-3xl font-bold text-white font-['JetBrains_Mono']">LAA PATENT</p>
							<p class="text-[11px] text-zinc-500 uppercase tracking-wider font-['JetBrains_Mono']">Heart Device</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer & Direct Engagement -->
		<footer id="contact" class="relative z-10 py-24 px-6 border-t border-white/10 bg-black/80">
			<div class="max-w-6xl mx-auto flex flex-col lg:flex-row justify-between items-start lg:items-center gap-12">
				<div class="space-y-4 max-w-xl">
					<span class="font-['JetBrains_Mono'] text-xs text-indigo-400 tracking-widest uppercase">// DIRECT ENGAGEMENT</span>
					<h2 class="text-4xl font-light">Building what's next.</h2>
					<p class="text-zinc-400 text-sm font-light leading-relaxed">
						Available for advisory boards, key opinion leadership, trend strategy, and venture creation.
					</p>
				</div>

				<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full lg:w-auto">
					<a href="mailto:contact@meetarnab.com" class="px-8 py-4 rounded-full bg-white text-black font-semibold text-xs tracking-wider uppercase font-['JetBrains_Mono'] hover:bg-zinc-200 transition-all text-center">
						Email Directly
					</a>
					<a href="https://www.linkedin.com/in/arnabchakraborty" target="_blank" class="px-8 py-4 rounded-full glass-card text-white font-semibold text-xs tracking-wider uppercase font-['JetBrains_Mono'] hover:bg-white/10 transition-all text-center">
						LinkedIn
					</a>
				</div>
			</div>

			<div class="max-w-6xl mx-auto mt-20 pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4 font-['JetBrains_Mono'] text-xs text-zinc-600">
				<div>© 2026 ARNAB CHAKRABORTY. ALL RIGHTS RESERVED.</div>
				<div class="flex items-center gap-6">
					<a href="https://instagram.com/awokenmatter" target="_blank" class="hover:text-white transition-colors">INSTAGRAM</a>
					<a href="https://www.linkedin.com/in/arnabchakraborty" target="_blank" class="hover:text-white transition-colors">LINKEDIN</a>
				</div>
			</div>
		</footer>

	</body>
</html>
